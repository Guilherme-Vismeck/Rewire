manifest {
    name        = 'RewireNF'
    description = 'Differential gene co-expression and network rewiring pipeline'
    version     = '0.6.0'
    mainScript  = 'main.nf'
}

params {
    // input
    expression               = null
    metadata                 = null
    group_col                = 'condition'
    group_a                  = null
    group_b                  = null

    // networks
    method                   = 'pearson'
    min_cor                  = 0.6
    fdr                      = 0.05
    top_variable_genes       = 3000

    // bootstrap
    bootstrap                = 100
    bootstrap_seed           = 42
    stability_threshold      = 0.8

    // differential expression
    run_de                   = true
    de_fdr                   = 0.05
    min_logfc                = 0
    min_rewired_edges        = 1

    // communities
    community_resolution     = 1.0
    community_seed           = 42
    module_overlap_threshold = 0.5

    // enrichment
    run_enrichment           = false
    organism                 = null
    gene_sets                = null
    gene_id_type             = 'SYMBOL'
    run_kegg                 = true
    enrich_fdr               = 0.05
    enrich_min_size          = 5
    enrich_max_size          = 500
    enrich_min_overlap       = 2

    // report
    run_report               = true

    // output
    outdir                   = 'results'
}

profiles {
    test {
        includeConfig 'conf/test.config'
    }
}
